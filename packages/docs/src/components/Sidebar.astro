---
import { getCollection } from 'astro:content';

interface Props {
  currentSlug?: string;
}

const { currentSlug } = Astro.props;

// Reading order: explicit `order` when set, otherwise publication date.
const orderKey = (p: { data: { order?: number; pubDate: Date } }) =>
  p.data.order ?? p.data.pubDate.valueOf();
const posts = (await getCollection('blog')).sort((a, b) => orderKey(a) - orderKey(b));
---

<aside class="sidebar">
  <a href="/hecatoncheires/" class="sidebar-logo" title="Yeah, the name is silly, but ain't all software project names?">
    <img src="/hecatoncheires/hecatoncheires-icon.svg" alt="Hecatoncheires project icon" />
  </a>
  <p class="sidebar-title">Hecatoncheires</p>
  <ul class="sidebar-nav">
    <li class="nav-home">
      <a href="/hecatoncheires/">Home</a>
    </li>
    <li>
      <span class="sidebar-section-label">Posts</span>
    </li>
    {posts.map((post, i) => (
      <li>
        {post.id === currentSlug ? (
          <span class="nav-current">
            <span class="nav-num">{i + 1}.</span> {post.data.navTitle ?? post.data.title}
          </span>
        ) : (
          <a href={`/hecatoncheires/blog/${post.id.replace(/\.\w+$/, '')}/`}>
            <span class="nav-num">{i + 1}.</span> {post.data.navTitle ?? post.data.title}
          </a>
        )}
      </li>
    ))}
    <li class="nav-repo">
      <a href="https://github.com/MikeORed/hecatoncheires" target="_blank" rel="noopener noreferrer">GitHub</a>
    </li>
  </ul>
  <!-- Sampling notice: remove when the license opens (target mid-Sept 2026). Paired with the
       README license note; both come out together. -->
  <p class="sidebar-notice">
    Read along, but please hold off on sampling the code for now. I expect to open it up around
    mid-September 2026.
  </p>
</aside>
